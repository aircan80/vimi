<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VibeMiner.Formats.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(MSBuildThisFileDirectory)../../../../../vibeminer</ReferenceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VibeMiner.Formats"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Formats/bin/Release/net10.0/VibeMiner.Formats.dll</HintPath></Reference>
    <Reference Include="VibeMiner.Generated"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Generated/bin/Release/net10.0/VibeMiner.Generated.dll</HintPath></Reference>
    <Reference Include="VibeMiner.Objects"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Objects/bin/Release/net10.0/VibeMiner.Objects.dll</HintPath></Reference>
    <Reference Include="VibeMiner.Files"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Files/bin/Release/net10.0/VibeMiner.Files.dll</HintPath></Reference>
    <Reference Include="VibeMiner.Builds"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Builds/bin/Release/net10.0/VibeMiner.Builds.dll</HintPath></Reference>
    <Reference Include="VibeMiner.ObjectAccess"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.ObjectAccess/bin/Release/net10.0/VibeMiner.ObjectAccess.dll</HintPath></Reference>
    <Reference Include="VibeMiner.Cdn"><HintPath>$(ReferenceRoot)/src/backend/VibeMiner.Cdn/bin/Release/net10.0/VibeMiner.Cdn.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>
</Project>
